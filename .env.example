# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://storage.elonn.local

# --- Database ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elonn_storage
DB_USERNAME=elonn_storage
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Storage ----------------------------------------------------------
STORAGE_RESOURCE_PATH=storage/resources

# --- Service authentication ------------------------------------------
# Must match paint.elonn.local's ELONN_STORAGE_SERVICE_TOKEN exactly.
ELONN_PAINT_SERVICE_TOKEN=

# Optional Operations Center access.
ELONN_ADMIN_SERVICE_TOKEN=
