# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://storage.elonn.local

# --- Database ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elonn_storage
DB_USERNAME=elonn_storage
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Storage ----------------------------------------------------------
STORAGE_RESOURCE_PATH=storage/resources

# --- Service authentication ------------------------------------------
# Shared secret for this pair -- same key, same value, in paint.elonn.local's
# own .env.
ELONN_PAINT_STORAGE_TOKEN=

# Shared secret for this pair -- same key, same value, in
# messages.elonn.local's own .env.
ELONN_MESSAGES_STORAGE_TOKEN=

# Optional Operations Center access.
ELONN_ADMIN_STORAGE_TOKEN=
